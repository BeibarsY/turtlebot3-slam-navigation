<?xml version="1.0"?>
<model>
  <name>labyrinth</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>ROBT 502 Group</name>
    <email>ybraiakhynov@gmail.com</email>
  </author>

  <description>
    Custom labyrinth maze environment used for TurtleBot3 SLAM and
    autonomous navigation experiments. The walls are imported from an
    STL mesh placed under meshes/labyrinth.stl. The model is declared
    static so it does not move under TurtleBot3 contact forces during
    teleoperation or Nav2 driven motion.
  </description>
</model>
